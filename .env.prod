###> symfony/framework-bundle ###
# Production environment defaults
APP_ENV=prod
# APP_SECRET will be auto-generated at runtime if not set via environment variable
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# DATABASE_URL will be provided by Railway environment variable
# Format: mysql://user:password@host:port/database
# This is set in railway.json or Railway dashboard
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# Production email configuration - disabled by default
MAILER_DSN=null://null
###< symfony/mailer ###

###> nelmio/cors-bundle ###
# Allow all HTTPS origins in production (tighten as needed)
CORS_ALLOW_ORIGIN=^https?://
###< nelmio/cors-bundle ###
