{% extends 'base.html.twig' %}

{% block title %}Activity Logs{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .activity-shell {
        display: grid;
        gap: 18px;
        font-family: 'Lato', sans-serif;
    }

    .ledger-hero {
        border-radius: 18px;
        padding: 20px;
        border: 1px solid #5f3e2f;
        background:
            radial-gradient(circle at 12% 18%, rgba(255, 199, 149, 0.25), transparent 30%),
            linear-gradient(130deg, #2a1f1c 0%, #493025 55%, #603c2c 100%);
        color: #fff4e7;
        box-shadow: 0 16px 32px rgba(58, 34, 25, 0.2);
        position: relative;
        overflow: hidden;
    }

    .ledger-hero::after {
        content: '';
        position: absolute;
        inset: 0;
        background-image: linear-gradient(transparent 94%, rgba(255, 255, 255, 0.05) 94%);
        background-size: 100% 26px;
        pointer-events: none;
    }

    .hero-top {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 14px;
    }

    .hero-kicker {
        display: inline-block;
        font-size: 0.68rem;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        border: 1px solid rgba(255, 232, 206, 0.45);
        border-radius: 999px;
        padding: 0.28rem 0.66rem;
        margin-bottom: 10px;
        color: #ffe0bb;
    }

    .ledger-hero h1 {
        margin: 0;
        font-family: 'Playfair Display', serif;
        font-size: clamp(1.4rem, 2.4vw, 2.2rem);
        line-height: 1.2;
    }

    .activity-subtitle {
        margin-top: 8px;
        color: #ead5c2;
        max-width: 540px;
    }

    .hero-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .stats-row {
        display: grid;
        grid-template-columns: repeat(3, minmax(180px, 1fr));
        gap: 12px;
    }

    .mini-stat {
        padding: 16px;
        border-radius: 14px;
        border: 1px solid #e5d2c0;
        background: linear-gradient(170deg, #fffdfb 0%, #fff5e9 100%);
        box-shadow: 0 10px 18px rgba(84, 54, 38, 0.08);
    }

    .mini-stat .label {
        font-size: 0.68rem;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: #7d6559;
    }

    .mini-stat .value {
        font-size: 1.7rem;
        font-weight: 800;
        color: #3c2b23;
        margin-top: 7px;
    }

    .table-container {
        padding: 16px;
        border-radius: 14px;
        border: 1px solid #e7d7c8;
        background: linear-gradient(180deg, #fffcf8 0%, #fff8f0 100%);
    }

    .actions-row {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 14px;
    }

    .actions-row .btn {
        text-decoration: none;
    }

    .table-wrap {
        overflow-x: auto;
        border: 1px solid #ead7c6;
        border-radius: 12px;
        background: #fffdfa;
    }

    .log-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 780px;
    }

    .log-table th {
        text-align: left;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.11em;
        color: #766257;
        padding: 12px 10px;
        border-bottom: 1px solid #ead8c8;
    }

    .log-table td {
        padding: 12px 10px;
        border-bottom: 1px solid #f0e2d5;
        color: #3b2e28;
        vertical-align: top;
        font-size: 0.9rem;
        line-height: 1.4;
    }

    .log-table tr:hover td { background: #fff6ee; }

    .pill {
        display: inline-flex;
        align-items: center;
        padding: 0.26rem 0.62rem;
        border-radius: 999px;
        font-size: 0.69rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .pill-login { background: #e6f4ec; color: #2a7a53; }
    .pill-logout { background: #f0ece8; color: #6b5950; }
    .pill-create { background: #efe8ff; color: #5a3ea0; }
    .pill-update { background: #fff1de; color: #9c5d1b; }
    .pill-delete { background: #fde8e5; color: #a1382f; }

    .mono {
        font-family: Consolas, 'Courier New', monospace;
        font-size: 0.8rem;
        color: #745f54;
    }

    .soft { color: #7a665a; font-size: 0.82rem; }

    .user-link {
        color: #5a392a;
        text-decoration: none;
        font-weight: 700;
    }

    .user-link:hover { text-decoration: underline; }

    .empty-state {
        padding: 20px;
        text-align: center;
        border-radius: 10px;
        background: #fff7ef;
        border: 1px dashed #dfc8b3;
        color: #7a6255;
    }

    @media (max-width: 960px) {
        .stats-row { grid-template-columns: 1fr; }
        .hero-top { flex-direction: column; }
    }
</style>
{% endblock %}

{% block body %}
<div class="activity-shell">
    <div class="ledger-hero">
        <div class="hero-top">
            <div>
                <span class="hero-kicker">Audit Intelligence</span>
                <h1>System Activity Center</h1>
                <p class="activity-subtitle">Monitor sign-ins, CRUD events, and accountability trails in one place.</p>
            </div>
            <div class="hero-actions">
                <a href="{{ path('app_dashboard_index') }}" class="btn btn-secondary">Back to Dashboard</a>
            </div>
        </div>
    </div>

    <div class="stats-row">
        <div class="mini-stat">
            <div class="label">Total Logs</div>
            <div class="value">{{ statistics.total }}</div>
        </div>
        <div class="mini-stat">
            <div class="label">Today</div>
            <div class="value">{{ statistics.today }}</div>
        </div>
        <div class="mini-stat">
            <div class="label">Listed</div>
            <div class="value">{{ logs|length }}</div>
        </div>
    </div>

    <div class="table-container">
        <div class="actions-row">
            <a href="{{ path('app_activity_log_index') }}" class="btn btn-primary">All</a>
            <a href="{{ path('app_activity_log_by_action', {action: 'login'}) }}" class="btn btn-secondary">Login</a>
            <a href="{{ path('app_activity_log_by_action', {action: 'logout'}) }}" class="btn btn-secondary">Logout</a>
            <a href="{{ path('app_activity_log_by_action', {action: 'create'}) }}" class="btn btn-secondary">Create</a>
            <a href="{{ path('app_activity_log_by_action', {action: 'update'}) }}" class="btn btn-secondary">Update</a>
            <a href="{{ path('app_activity_log_by_action', {action: 'delete'}) }}" class="btn btn-secondary">Delete</a>
        </div>

        <div class="table-wrap">
            <table class="log-table">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Role</th>
                        <th>Action</th>
                        <th>Target Data</th>
                        <th>Date and Time</th>
                        <th>IP Address</th>
                    </tr>
                </thead>
                <tbody>
                    {% for log in logs %}
                        <tr>
                            <td>
                                {% if log.userId is not null %}
                                    <a class="user-link" href="{{ path('app_activity_log_by_user', {userId: log.userId}) }}">{{ log.username }}</a>
                                    <div class="mono">#{{ log.userId }}</div>
                                {% else %}
                                    <span>{{ log.username }}</span>
                                {% endif %}
                            </td>
                            <td class="soft">{{ log.formattedRole }}</td>
                            <td><span class="pill pill-{{ log.action|lower }}">{{ log.action }}</span></td>
                            <td>{{ log.targetData }}</td>
                            <td>
                                {{ log.dateTime|date('M d, Y') }}
                                <div class="mono">{{ log.dateTime|date('h:i:s A') }}</div>
                            </td>
                            <td class="mono">{{ log.ipAddress ?? 'N/A' }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6">
                                <div class="empty-state">No activity logs found yet.</div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}