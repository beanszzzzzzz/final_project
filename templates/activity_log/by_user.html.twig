{% extends 'base.html.twig' %}

{% block title %}Activity Logs - User {{ userId }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .user-activity-shell {
        display: grid;
        gap: 18px;
        font-family: 'Lato', sans-serif;
    }

    .ledger-hero {
        border-radius: 18px;
        padding: 20px;
        border: 1px solid #5f3e2f;
        background:
            radial-gradient(circle at 12% 18%, rgba(255, 199, 149, 0.25), transparent 30%),
            linear-gradient(130deg, #2a1f1c 0%, #493025 55%, #603c2c 100%);
        color: #fff4e7;
        box-shadow: 0 16px 32px rgba(58, 34, 25, 0.2);
        position: relative;
        overflow: hidden;
    }

    .ledger-hero::after {
        content: '';
        position: absolute;
        inset: 0;
        background-image: linear-gradient(transparent 94%, rgba(255, 255, 255, 0.05) 94%);
        background-size: 100% 26px;
        pointer-events: none;
    }

    .hero-top {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 14px;
    }

    .hero-kicker {
        display: inline-block;
        font-size: 0.68rem;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        border: 1px solid rgba(255, 232, 206, 0.45);
        border-radius: 999px;
        padding: 0.28rem 0.66rem;
        margin-bottom: 10px;
        color: #ffe0bb;
    }

    .ledger-hero h1 {
        margin: 0;
        font-family: 'Playfair Display', serif;
        font-size: clamp(1.4rem, 2.4vw, 2.2rem);
        line-height: 1.2;
    }

    .meta-line { margin-top: 8px; color: #ead5c2; }

    .summary-card {
        padding: 16px;
        border-radius: 14px;
        border: 1px solid #e5d2c0;
        background: linear-gradient(170deg, #fffdfb 0%, #fff5e9 100%);
        box-shadow: 0 10px 18px rgba(84, 54, 38, 0.08);
    }

    .summary-title {
        font-size: 0.78rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #7b665b;
    }

    .summary-value {
        font-size: 1.7rem;
        font-weight: 800;
        color: #3b2b23;
        margin-top: 7px;
    }

    .table-container {
        padding: 16px;
        border-radius: 14px;
        border: 1px solid #e7d7c8;
        background: linear-gradient(180deg, #fffcf8 0%, #fff8f0 100%);
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        padding: 0.24rem 0.6rem;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }
    .status-login { background: #e6f4ec; color: #2a7a53; }
    .status-logout { background: #f0ece8; color: #6b5950; }
    .status-create { background: #efe8ff; color: #5a3ea0; }
    .status-update { background: #fff1de; color: #9c5d1b; }
    .status-delete { background: #fde8e5; color: #a1382f; }

    .table-container {
        padding: 16px;
        border-radius: 14px;
    }

    .table-wrap {
        overflow-x: auto;
        border: 1px solid #ead7c6;
        border-radius: 12px;
        background: #fffdfa;
    }
    .log-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 740px;
    }
    .log-table th {
        text-align: left;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.11em;
        color: #766257;
        padding: 12px 10px;
        border-bottom: 1px solid #ead8c8;
    }
    .log-table td {
        padding: 12px 10px;
        border-bottom: 1px solid #f0e2d5;
        color: #3b2e28;
        vertical-align: top;
        font-size: 0.9rem;
        line-height: 1.4;
    }
    .log-table tr:hover td { background: #fff6ee; }
    .mono {
        font-family: Consolas, 'Courier New', monospace;
        font-size: 0.8rem;
        color: #745f54;
    }

    .empty-state {
        padding: 20px;
        text-align: center;
        border-radius: 10px;
        background: #fff7ef;
        border: 1px dashed #dfc8b3;
        color: #7a6255;
    }

    .soft { color: #7a665a; font-size: 0.82rem; }

    @media (max-width: 960px) {
        .hero-top { flex-direction: column; }
    }
</style>
{% endblock %}

{% block body %}
{% set latestLog = logs|first %}
<div class="user-activity-shell">
    <div class="ledger-hero">
        <div class="hero-top">
            <div>
                <span class="hero-kicker">Audit Intelligence</span>
                <h1>User Activity Logs</h1>
                <p class="meta-line">Audit trail for user ID #{{ userId }}</p>
            </div>
            <div style="display:flex; gap:8px; flex-wrap:wrap;">
                <a href="{{ path('app_activity_log_index') }}" class="btn btn-secondary">All Logs</a>
                <a href="{{ path('app_dashboard_index') }}" class="btn btn-primary">Dashboard</a>
            </div>
        </div>
    </div>

    <div class="summary-card">
        <div class="summary-title">Entries Found</div>
        <div class="summary-value">{{ logs|length }}</div>
        {% if latestLog %}
            <div class="soft">Latest: {{ latestLog.action }} on {{ latestLog.dateTime|date('M d, Y h:i:s A') }}</div>
        {% endif %}
    </div>

    <div class="table-container">
        <div class="table-wrap">
            <table class="log-table">
                <thead>
                    <tr>
                        <th>Username</th>
                        <th>Role</th>
                        <th>Action</th>
                        <th>Target Data</th>
                        <th>Date and Time</th>
                        <th>IP Address</th>
                    </tr>
                </thead>
                <tbody>
                    {% for log in logs %}
                        <tr>
                            <td>{{ log.username }}</td>
                            <td class="soft">{{ log.formattedRole }}</td>
                            <td><span class="status-pill status-{{ log.action|lower }}">{{ log.action }}</span></td>
                            <td>{{ log.targetData }}</td>
                            <td>
                                {{ log.dateTime|date('M d, Y') }}
                                <div class="mono">{{ log.dateTime|date('h:i:s A') }}</div>
                            </td>
                            <td class="mono">{{ log.ipAddress ?? 'N/A' }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6">
                                <div class="empty-state">No activity logs found for this user.</div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
