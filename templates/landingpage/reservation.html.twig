{% extends 'base.html.twig' %}
{% block title %}Reserve - Bins Cafe{% endblock %}

{% block stylesheets %}
<style>
    @keyframes fadeUpSoft {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .reserve-hero {
        min-height: calc(100vh - 68px);
        padding: 4.5rem 1.4rem;
        background:
            radial-gradient(circle at 12% 18%, rgba(198, 134, 74, 0.23), transparent 32%),
            radial-gradient(circle at 87% 82%, rgba(122, 69, 40, 0.2), transparent 36%),
            linear-gradient(140deg, #2d1711 0%, #3d2219 50%, #4c2c1b 100%);
        display: grid;
        place-items: center;
    }

    .reserve-panel {
        width: 100%;
        max-width: 980px;
        display: grid;
        grid-template-columns: 1.1fr 1fr;
        border-radius: 18px;
        overflow: hidden;
        border: 1px solid rgba(255, 240, 224, 0.2);
        box-shadow: 0 16px 36px rgba(27, 14, 10, 0.34);
        animation: fadeUpSoft 0.62s ease-out both;
    }

    .reserve-left {
        padding: 2.2rem;
        background: rgba(255, 246, 235, 0.08);
        color: #fcebd8;
        animation: fadeUpSoft 0.6s ease-out 0.05s both;
    }

    .reserve-kicker {
        display: inline-block;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        border: 1px solid rgba(255, 232, 206, 0.4);
        border-radius: 999px;
        padding: 0.26rem 0.62rem;
        margin-bottom: 0.9rem;
    }

    .reserve-title {
        font-family: 'Playfair Display', serif;
        font-size: clamp(1.9rem, 2.8vw, 2.4rem);
        line-height: 1.2;
        margin: 0 0 0.8rem;
    }

    .reserve-text {
        color: #ebd0b5;
        line-height: 1.7;
        font-size: 0.95rem;
        margin-bottom: 1.2rem;
    }

    .reserve-note {
        border: 1px solid rgba(255, 232, 206, 0.3);
        border-radius: 12px;
        padding: 0.9rem;
        font-size: 0.86rem;
        color: #f7dfc7;
        background: rgba(255, 246, 235, 0.06);
    }

    .reserve-right {
        padding: 2.2rem;
        background: #fff8ef;
        animation: fadeUpSoft 0.6s ease-out 0.1s both;
    }

    .reserve-form {
        display: grid;
        gap: 0.95rem;
    }

    .reserve-form label {
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: #5a3d2f;
        font-weight: 700;
        margin-bottom: 0.35rem;
        display: block;
    }

    .reserve-form input,
    .reserve-form select,
    .reserve-form textarea {
        width: 100%;
        border: 1px solid #e5cfb7;
        border-radius: 10px;
        padding: 0.82rem 0.88rem;
        background: #fffcf8;
        color: #3f2b21;
        font-family: 'Lato', sans-serif;
        font-size: 0.92rem;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .reserve-form input:focus,
    .reserve-form select:focus,
    .reserve-form textarea:focus {
        border-color: #bf8458;
        box-shadow: 0 0 0 3px rgba(191, 132, 88, 0.18);
    }

    .reserve-form textarea { min-height: 90px; resize: vertical; }

    .reserve-btn {
        margin-top: 0.3rem;
        border: none;
        border-radius: 10px;
        padding: 0.9rem 1rem;
        background: linear-gradient(125deg, #5a3422 0%, #7a4a31 100%);
        color: #fff7ef;
        font-weight: 700;
        letter-spacing: 0.05em;
        cursor: pointer;
    }

    .reserve-btn:hover { filter: brightness(1.04); }

    @media (max-width: 900px) {
        .reserve-panel { grid-template-columns: 1fr; }
        .reserve-left,
        .reserve-right { padding: 1.5rem; }
    }

    @media (prefers-reduced-motion: reduce) {
        .reserve-panel,
        .reserve-left,
        .reserve-right {
            animation: none !important;
        }
    }
</style>
{% endblock %}

{% block body %}
<section class="reserve-hero">
    <div class="reserve-panel">
        <div class="reserve-left">
            <span class="reserve-kicker">Bins Cafe Reserve</span>
            <h1 class="reserve-title">Book your table before you arrive.</h1>
            <p class="reserve-text">
                Reserve a cozy spot for coffee dates, meetings, or weekend catch-ups.
                We will confirm your booking details through email or phone.
            </p>
            <div class="reserve-note">
                Reservation hours: Daily 7:00 AM to 10:00 PM. For large groups of 8+, please add details in notes.
            </div>
        </div>

        <div class="reserve-right">
            <form class="reserve-form" method="post" action="{{ path('app_contact_send') }}">
                <div>
                    <label for="reserve_name">Full Name</label>
                    <input id="reserve_name" type="text" name="first_name" placeholder="Your full name" required>
                </div>
                <div>
                    <label for="reserve_email">Email</label>
                    <input id="reserve_email" type="email" name="email" placeholder="you@example.com" required>
                </div>
                <div>
                    <label for="reserve_date">Preferred Date</label>
                    <input id="reserve_date" type="date" name="subject" required>
                </div>
                <div>
                    <label for="reserve_message">Reservation Details</label>
                    <textarea id="reserve_message" name="message" placeholder="Party size, preferred time, and special requests" required></textarea>
                </div>
                <button class="reserve-btn" type="submit">Submit Reservation Request</button>
            </form>
        </div>
    </div>
</section>
{% endblock %}
