{% extends 'base.html.twig' %}
{% block title %}Contact Us — Bins Cafe{% endblock %}

{% block stylesheets %}
<style>
    @keyframes fadeUpSoft {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .page-hero { background: var(--brown-dark); padding: 6rem 2rem 5rem; text-align: center; position: relative; overflow: hidden; }
    .page-hero::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse 60% 80% at 50% 100%, rgba(200,134,74,0.2) 0%, transparent 70%); }
    .page-hero-content { position: relative; z-index: 1; animation: fadeUpSoft 0.6s ease-out both; }
    .page-hero-tag { display: inline-block; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.2em; color: var(--accent); border: 1px solid rgba(200,134,74,0.4); padding: 0.35rem 1rem; border-radius: 50px; margin-bottom: 1.5rem; }
    .page-hero h1 { font-family: 'Playfair Display', serif; font-size: clamp(2.2rem, 5vw, 3.5rem); color: var(--cream-light); line-height: 1.2; margin-bottom: 1rem; }
    .page-hero p { font-size: 1.05rem; color: var(--cream-dark); opacity: 0.8; max-width: 500px; margin: 0 auto; line-height: 1.75; }

    .contact-main { background: var(--cream-light); }
    .contact-grid { display: grid; grid-template-columns: 1fr 1.3fr; gap: 4rem; align-items: start; }
    .contact-info-panel,
    .contact-form-card,
    .map-box { animation: fadeUpSoft 0.58s ease-out both; }
    .contact-form-card { animation-delay: 0.08s; }
    .map-box { animation-delay: 0.12s; }

    .contact-info-panel { display: flex; flex-direction: column; gap: 1.5rem; }
    .info-card { background: var(--white); border-radius: 12px; padding: 1.5rem; border: 1px solid var(--cream-dark); display: flex; gap: 1.2rem; align-items: flex-start; transition: box-shadow 0.2s; }
    .info-card { animation: fadeUpSoft 0.5s ease-out both; }
    .info-card:nth-child(2) { animation-delay: 0.03s; }
    .info-card:nth-child(3) { animation-delay: 0.06s; }
    .info-card:nth-child(4) { animation-delay: 0.09s; }
    .info-card:nth-child(5) { animation-delay: 0.12s; }
    .info-card:hover { box-shadow: 0 4px 20px rgba(59,31,31,0.08); }
    .info-icon { width: 48px; height: 48px; background: var(--brown-dark); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; flex-shrink: 0; }
    .info-label { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--accent); margin-bottom: 0.3rem; }
    .info-value { font-size: 0.95rem; color: var(--text-mid); line-height: 1.6; }
    .info-value strong { display: block; color: var(--brown-dark); font-size: 1rem; }

    .social-row { display: flex; gap: 1rem; margin-top: 0.5rem; }
    .social-btn { background: var(--brown-dark); color: var(--cream-light); padding: 0.5rem 1.2rem; border-radius: 6px; font-size: 0.82rem; font-weight: 700; text-decoration: none; transition: background 0.2s; }
    .social-btn:hover { background: var(--brown-mid); }

    /* FORM */
    .contact-form-card { background: var(--white); border-radius: 16px; padding: 2.5rem; border: 1px solid var(--cream-dark); box-shadow: 0 4px 30px rgba(59,31,31,0.06); }
    .form-title { font-family: 'Playfair Display', serif; font-size: 1.6rem; color: var(--brown-dark); margin-bottom: 0.4rem; }
    .form-sub { font-size: 0.88rem; color: var(--text-mid); margin-bottom: 2rem; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem; }
    .form-group { display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: 1rem; }
    .form-group label { font-size: 0.8rem; font-weight: 700; color: var(--brown-dark); text-transform: uppercase; letter-spacing: 0.06em; }
    .form-group input, .form-group select, .form-group textarea {
        padding: 0.75rem 1rem;
        border: 1.5px solid var(--cream-dark);
        border-radius: 8px;
        font-family: 'Lato', sans-serif;
        font-size: 0.92rem;
        color: var(--text-dark);
        background: var(--cream-light);
        transition: border-color 0.2s, box-shadow 0.2s;
        outline: none;
        resize: vertical;
    }
    .form-group input:focus, .form-group select:focus, .form-group textarea:focus {
        border-color: var(--accent);
        box-shadow: 0 0 0 3px rgba(200,134,74,0.15);
        background: var(--white);
    }
    .form-submit { width: 100%; padding: 1rem; background: var(--brown-dark); color: var(--cream-light); border: none; border-radius: 8px; font-family: 'Lato', sans-serif; font-size: 0.95rem; font-weight: 700; letter-spacing: 0.05em; cursor: pointer; transition: background 0.2s, transform 0.15s; }
    .form-submit:hover { background: var(--brown-mid); transform: translateY(-1px); }

    /* Map placeholder */
    .map-section { background: var(--cream-mid); padding: 0 2rem 5rem; }
    .map-box { max-width: 1200px; margin: 0 auto; background: var(--brown-dark); border-radius: 16px; height: 300px; display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 1rem; overflow: hidden; }
    .map-box p { font-family: 'Playfair Display', serif; font-size: 1.2rem; color: var(--cream-light); }
    .map-box span { font-size: 0.85rem; color: var(--text-light); }

    /* Flash messages */
    .flash { max-width: 1200px; margin: 1.5rem auto; padding: 1rem 1.5rem; border-radius: 8px; font-weight: 700; font-size: 0.95rem; }
    .flash-success { background: #d4edda; color: #155724; border: 1px solid #c3e6cb; }
    .flash-error   { background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }

    .sticker {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.4em;
        height: 1.4em;
        border-radius: 999px;
        font-size: 0.95em;
        line-height: 1;
        font-weight: 700;
        background: var(--accent);
        color: var(--white);
    }

    .info-icon .sticker {
        width: 1.8em;
        height: 1.8em;
        background: transparent;
        color: var(--cream-light);
        border: 1px solid rgba(255, 255, 255, 0.35);
    }

    .sticker-success {
        background: #2e7d32;
        color: #fff;
    }

    .sticker-error {
        background: #c62828;
        color: #fff;
    }

    .sticker-map {
        margin-right: 0.35rem;
        background: var(--accent);
        color: var(--white);
    }

    @media (max-width: 768px) {
        .contact-grid { grid-template-columns: 1fr; }
        .form-row { grid-template-columns: 1fr; }
    }

    @media (prefers-reduced-motion: reduce) {
        .page-hero-content,
        .contact-info-panel,
        .contact-form-card,
        .map-box,
        .info-card {
            animation: none !important;
        }
    }
</style>
{% endblock %}

{% block body %}

{# Flash messages #}
{% for message in app.flashes('success') %}
    <div class="flash flash-success"><span class="sticker sticker-success">✓</span> {{ message }}</div>
{% endfor %}
{% for message in app.flashes('error') %}
    <div class="flash flash-error"><span class="sticker sticker-error">!</span> {{ message }}</div>
{% endfor %}

<div class="page-hero">
    <div class="page-hero-content">
        <span class="page-hero-tag">Reach Out</span>
        <h1>Contact Us</h1>
        <p>We love hearing from our guests. Drop us a message and we'll get back to you faster than your espresso brews.</p>
    </div>
</div>

<section class="contact-main">
    <div class="container">
        <div class="contact-grid">
            <div class="contact-info-panel">
                <div>
                    <p class="section-label">Find Us</p>
                    <h2 class="section-title">Let's Connect</h2>
                    <p class="section-sub" style="margin-bottom: 2rem;">Visit us in-store or reach out through any of the channels below.</p>
                </div>
                <div class="info-card">
                    <div class="info-icon"><span class="sticker">⌖</span></div>
                    <div>
                        <p class="info-label">Address</p>
                        <div class="info-value"><strong>Poblacion, San Jose</strong>F Siglos st.,6062, Philippines</div>
                    </div>
                </div>
                <div class="info-card">
                    <div class="info-icon"><span class="sticker">◷</span></div>
                    <div>
                        <p class="info-label">Opening Hours</p>
                        <div class="info-value"><strong>Mon–Fri: 7:00am – 9:00pm</strong>Sat–Sun: 8:00am – 10:00pm</div>
                    </div>
                </div>
                <div class="info-card">
                    <div class="info-icon"><span class="sticker">☎</span></div>
                    <div>
                        <p class="info-label">Phone</p>
                        <div class="info-value"><strong>+63 912 345 6789</strong>Available during store hours</div>
                    </div>
                </div>
                <div class="info-card">
                    <div class="info-icon"><span class="sticker">✉</span></div>
                    <div>
                        <p class="info-label">Email</p>
                        <div class="info-value"><strong>hello@binscafe.com</strong>We reply within 24 hours</div>
                    </div>
                </div>
                <div>
                    <p style="font-size:0.8rem; color: var(--text-light); text-transform:uppercase; letter-spacing:0.1em; margin-bottom:0.75rem;">Follow Us</p>
                    <div class="social-row">
                        <a href="#" class="social-btn">Facebook</a>
                        <a href="#" class="social-btn">Instagram</a>
                        <a href="#" class="social-btn">TikTok</a>
                    </div>
                </div>
            </div>

            <div class="contact-form-card">
                <h2 class="form-title">Send Us a Message</h2>
                <p class="form-sub">Fill out the form below and we'll be in touch shortly.</p>
                {# ✅ Updated form tag with action and method #}
                <form action="{{ path('app_contact_send') }}" method="POST">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="first-name">First Name</label>
                            <input type="text" id="first-name" name="first_name" placeholder="Juan">
                        </div>
                        <div class="form-group">
                            <label for="last-name">Last Name</label>
                            <input type="text" id="last-name" name="last_name" placeholder="dela Cruz">
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="email">Email Address</label>
                        <input type="email" id="email" name="email" placeholder="juan@email.com">
                    </div>
                    <div class="form-group">
                        <label for="subject">Subject</label>
                        <select id="subject" name="subject">
                            <option value="">Select a topic...</option>
                            <option>General Inquiry</option>
                            <option>Reservation / Event Booking</option>
                            <option>Feedback</option>
                            <option>Partnership</option>
                            <option>Other</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="message">Message</label>
                        <textarea id="message" name="message" rows="5" placeholder="Tell us what's on your mind..."></textarea>
                    </div>
                    <button type="submit" class="form-submit">Send Message →</button>
                </form>
            </div>
        </div>
    </div>
</section>

<div class="map-section">
    <div class="map-box">
        <p><span class="sticker sticker-map">⌖</span> Poblacion, San Jose, Negros Oriental</p>
        <span>Embed your Google Maps iframe here</span>
    </div>
</div>

{% endblock %}
