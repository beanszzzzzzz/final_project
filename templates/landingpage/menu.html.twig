{% extends 'base.html.twig' %}
{% block title %}Our Menu — Bins Cafe{% endblock %}

{% block stylesheets %}
<style>
    @keyframes fadeUpSoft {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .page-hero { background: var(--brown-dark); padding: 6rem 2rem 5rem; text-align: center; position: relative; overflow: hidden; }
    .page-hero::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse 60% 80% at 50% 100%, rgba(200,134,74,0.2) 0%, transparent 70%); }
    .page-hero-content { position: relative; z-index: 1; animation: fadeUpSoft 0.6s ease-out both; }
    .page-hero-tag { display: inline-block; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.2em; color: var(--accent); border: 1px solid rgba(200,134,74,0.4); padding: 0.35rem 1rem; border-radius: 50px; margin-bottom: 1.5rem; }
    .page-hero h1 { font-family: 'Playfair Display', serif; font-size: clamp(2.2rem, 5vw, 3.5rem); color: var(--cream-light); line-height: 1.2; margin-bottom: 1rem; }
    .page-hero p { font-size: 1.05rem; color: var(--cream-dark); opacity: 0.8; max-width: 500px; margin: 0 auto; line-height: 1.75; }

    .menu-section { background: var(--cream-light); }
    .menu-tabs { display: flex; gap: 0.5rem; justify-content: center; flex-wrap: wrap; margin-bottom: 3.5rem; background: var(--white); padding: 0.6rem; border-radius: 12px; border: 1px solid var(--cream-dark); display: inline-flex; left: 50%; position: relative; transform: translateX(-50%); }
    .menu-tab { padding: 0.6rem 1.5rem; border-radius: 8px; font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; cursor: pointer; border: none; background: transparent; color: var(--text-mid); transition: all 0.2s; white-space: nowrap; }
    .menu-tab.active, .menu-tab:hover { background: var(--brown-dark); color: var(--cream-light); }
    .menu-category { margin-bottom: 4rem; animation: fadeUpSoft 0.55s ease-out both; }
    .menu-category:nth-child(2) { animation-delay: 0.06s; }
    .menu-category:nth-child(3) { animation-delay: 0.12s; }
    .menu-category-title { font-family: 'Playfair Display', serif; font-size: 1.6rem; color: var(--brown-dark); margin-bottom: 0.4rem; padding-bottom: 1rem; border-bottom: 1px solid var(--cream-dark); display: flex; align-items: center; gap: 0.75rem; }
    .menu-category-title span { font-size: 1.4rem; }
    .menu-symbol {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.7em;
        height: 1.7em;
        border-radius: 999px;
        background: var(--brown-dark);
        color: var(--cream-light);
        border: 1px solid rgba(0, 0, 0, 0.08);
        font-size: 0.78em;
        line-height: 1;
        font-weight: 700;
    }
    .menu-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--cream-dark); border-radius: 12px; overflow: hidden; margin-top: 1.5rem; }
    .menu-item { background: var(--white); padding: 1.5rem; display: flex; justify-content: space-between; align-items: center; gap: 1rem; transition: background 0.2s; animation: fadeUpSoft 0.45s ease-out both; }
    .menu-item:nth-child(2n) { animation-delay: 0.04s; }
    .menu-item:hover { background: var(--cream-light); }
    .menu-item-left { flex: 1; }
    .menu-item-name { font-family: 'Playfair Display', serif; font-size: 1rem; color: var(--brown-dark); margin-bottom: 0.3rem; }
    .menu-item-desc { font-size: 0.82rem; color: var(--text-light); line-height: 1.5; }
    .menu-item-badge { font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.1em; background: var(--brown-dark); color: var(--accent); padding: 0.2rem 0.6rem; border-radius: 50px; display: inline-block; margin-top: 0.4rem; }
    .menu-item-price { font-family: 'Playfair Display', serif; font-size: 1.15rem; color: var(--brown-dark); font-weight: 700; white-space: nowrap; }

    @media (max-width: 768px) {
        .menu-grid { grid-template-columns: 1fr; }
    }

    @media (prefers-reduced-motion: reduce) {
        .page-hero-content,
        .menu-category,
        .menu-item {
            animation: none !important;
        }
    }
</style>
{% endblock %}

{% block body %}

<div class="page-hero">
    <div class="page-hero-content">
        <span class="page-hero-tag">What We Serve</span>
        <h1>Our Menu</h1>
        <p>Every item is crafted with quality ingredients, a lot of care, and a dash of passion.</p>
    </div>
</div>

<section class="menu-section">
    <div class="container">

        <div class="menu-category">
            <h2 class="menu-category-title"><span class="menu-symbol">C</span> Coffee</h2>
            <div class="menu-grid">
                <div class="menu-item">
                    <div class="menu-item-left">
                        <p class="menu-item-name">Bins Classic Latte</p>
                        <p class="menu-item-desc">Double espresso with velvety steamed milk</p>
                        <span class="menu-item-badge">Signature</span>
                    </div>
                    <span class="menu-item-price">₱135</span>
                </div>
                <div class="menu-item">
                    <div class="menu-item-left">
                        <p class="menu-item-name">Americano</p>
                        <p class="menu-item-desc">Espresso shots with hot or cold water</p>
                    </div>
                    <span class="menu-item-price">₱110</span>
                </div>
                <div class="menu-item">
                    <div class="menu-item-left">
                        <p class="menu-item-name">Flat White</p>
                        <p class="menu-item-desc">Ristretto shots with microfoam milk</p>
                    </div>
                    <span class="menu-item-price">₱140</span>
                </div>
                <div class="menu-item">
                    <div class="menu-item-left">
                        <p class="menu-item-name">Caramel Macchiato</p>
                        <p class="menu-item-desc">Vanilla syrup, milk foam, espresso drizzle</p>
                        <span class="menu-item-badge">Popular</span>
                    </div>
                    <span class="menu-item-price">₱155</span>
                </div>
                <div class="menu-item">
                    <div class="menu-item-left">
                        <p class="menu-item-name">Cold Brew</p>
                        <p class="menu-item-desc">Steeped 18 hours, served over ice</p>
                    </div>
                    <span class="menu-item-price">₱150</span>
                </div>
                <div class="menu-item">
                    <div class="menu-item-left">
                        <p class="menu-item-name">Dirty Matcha</p>
                        <p class="menu-item-desc">Espresso shot over ceremonial grade matcha latte</p>
                        <span class="menu-item-badge">New</span>
                    </div>
                    <span class="menu-item-price">₱165</span>
                </div>
            </div>
        </div>

        <div class="menu-category">
            <h2 class="menu-category-title"><span class="menu-symbol">N</span> Non-Coffee</h2>
            <div class="menu-grid">
                <div class="menu-item">
                    <div class="menu-item-left">
                        <p class="menu-item-name">Brown Sugar Milk Tea</p>
                        <p class="menu-item-desc">Tiger stripes, tapioca pearls, fresh milk</p>
                        <span class="menu-item-badge">Best Seller</span>
                    </div>
                    <span class="menu-item-price">₱120</span>
                </div>
                <div class="menu-item">
                    <div class="menu-item-left">
                        <p class="menu-item-name">Matcha Oat Latte</p>
                        <p class="menu-item-desc">Ceremonial matcha, oat milk, honey</p>
                    </div>
                    <span class="menu-item-price">₱150</span>
                </div>
                <div class="menu-item">
                    <div class="menu-item-left">
                        <p class="menu-item-name">Mango Cold Brew</p>
                        <p class="menu-item-desc">Cold brew coffee with fresh Philippine mango</p>
                        <span class="menu-item-badge">Seasonal</span>
                    </div>
                    <span class="menu-item-price">₱145</span>
                </div>
                <div class="menu-item">
                    <div class="menu-item-left">
                        <p class="menu-item-name">Strawberry Lemonade</p>
                        <p class="menu-item-desc">Fresh squeezed with real strawberry puree</p>
                    </div>
                    <span class="menu-item-price">₱115</span>
                </div>
            </div>
        </div>

        <div class="menu-category">
            <h2 class="menu-category-title"><span class="menu-symbol">F</span> Food & Pastries</h2>
            <div class="menu-grid">
                <div class="menu-item">
                    <div class="menu-item-left">
                        <p class="menu-item-name">Butter Croissant</p>
                        <p class="menu-item-desc">Baked fresh every morning, flaky and golden</p>
                        <span class="menu-item-badge">Freshly Baked</span>
                    </div>
                    <span class="menu-item-price">₱85</span>
                </div>
                <div class="menu-item">
                    <div class="menu-item-left">
                        <p class="menu-item-name">Basque Cheesecake</p>
                        <p class="menu-item-desc">Burnt top, creamy center, served chilled</p>
                    </div>
                    <span class="menu-item-price">₱110</span>
                </div>
                <div class="menu-item">
                    <div class="menu-item-left">
                        <p class="menu-item-name">Ham & Cheese Panini</p>
                        <p class="menu-item-desc">Grilled ciabatta, honey ham, gouda cheese</p>
                    </div>
                    <span class="menu-item-price">₱145</span>
                </div>
                <div class="menu-item">
                    <div class="menu-item-left">
                        <p class="menu-item-name">Avocado Toast</p>
                        <p class="menu-item-desc">Sourdough, smashed avo, chili flakes, egg</p>
                        <span class="menu-item-badge">Healthy Pick</span>
                    </div>
                    <span class="menu-item-price">₱160</span>
                </div>
            </div>
        </div>

    </div>
</section>

{% endblock %}
