{% extends 'base.html.twig' %}
{% block title %}Log In — Bins Cafe{% endblock %}

{% block stylesheets %}
<style>
    @keyframes fadeUpSoft {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: translateY(0); }
    }

    body { background: var(--brown-dark); }

    .login-wrapper {
        min-height: calc(100vh - 68px);
        display: flex;
        align-items: stretch;
    }
    .login-left {
        flex: 1;
        background: var(--brown-dark);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 4rem 3rem;
        text-align: center;
        position: relative;
        overflow: hidden;
    }
    .login-left::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse 70% 60% at 50% 60%, rgba(200,134,74,0.18) 0%, transparent 70%);
    }
    .login-left-content { position: relative; z-index: 1; animation: fadeUpSoft 0.62s ease-out both; }
    .login-brand { font-family: 'Playfair Display', serif; font-size: 2.5rem; color: var(--cream-light); margin-bottom: 0.5rem; }
    .login-brand span { color: var(--accent); }
    .login-tagline { font-size: 0.9rem; color: var(--text-light); letter-spacing: 0.08em; margin-bottom: 3rem; }
    .login-icon { font-size: 6rem; margin-bottom: 2rem; }
    .login-quote {
        font-family: 'Playfair Display', serif;
        font-size: 1.3rem;
        font-style: italic;
        color: var(--cream-dark);
        line-height: 1.6;
        max-width: 300px;
        opacity: 0.75;
    }

    .login-right {
        width: 480px;
        background: var(--cream-light);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 3rem;
    }
    .login-card { width: 100%; max-width: 380px; animation: fadeUpSoft 0.62s ease-out 0.08s both; }
    .login-card-title { font-family: 'Playfair Display', serif; font-size: 2rem; color: var(--brown-dark); margin-bottom: 0.4rem; }
    .login-card-sub { font-size: 0.88rem; color: var(--text-mid); margin-bottom: 2.5rem; }

    .form-group { display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: 1.25rem; }
    .form-group label { font-size: 0.78rem; font-weight: 700; color: var(--brown-dark); text-transform: uppercase; letter-spacing: 0.07em; }
    .form-group input {
        padding: 0.85rem 1rem;
        border: 1.5px solid var(--cream-dark);
        border-radius: 8px;
        font-family: 'Lato', sans-serif;
        font-size: 0.95rem;
        color: var(--text-dark);
        background: var(--white);
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
    }
    .form-group input:focus {
        border-color: var(--accent);
        box-shadow: 0 0 0 3px rgba(200,134,74,0.15);
    }
    .form-options { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.75rem; font-size: 0.83rem; }
    .form-check { display: flex; align-items: center; gap: 0.5rem; color: var(--text-mid); cursor: pointer; }
    .form-check input[type="checkbox"] { accent-color: var(--brown-dark); }
    .form-forgot { color: var(--accent); text-decoration: none; font-size: 0.83rem; font-weight: 700; transition: color 0.2s; }
    .form-forgot:hover { color: var(--brown-mid); }
    .btn-login { width: 100%; padding: 1rem; background: var(--brown-dark); color: var(--cream-light); border: none; border-radius: 8px; font-family: 'Lato', sans-serif; font-size: 0.95rem; font-weight: 700; letter-spacing: 0.05em; cursor: pointer; transition: background 0.2s, transform 0.15s; margin-bottom: 1.5rem; }
    .btn-login:hover { background: var(--brown-mid); transform: translateY(-1px); }
    .login-divider { text-align: center; font-size: 0.8rem; color: var(--text-light); margin-bottom: 1.5rem; position: relative; }
    .login-divider::before, .login-divider::after { content: ''; position: absolute; top: 50%; width: 38%; height: 1px; background: var(--cream-dark); }
    .login-divider::before { left: 0; }
    .login-divider::after { right: 0; }
    .login-back { text-align: center; margin-top: 2rem; font-size: 0.85rem; color: var(--text-mid); }
    .login-back a { color: var(--accent); font-weight: 700; text-decoration: none; }
    .login-back a:hover { color: var(--brown-mid); }

    {% if app.flashes('error') is not empty %}
    .alert-error { background: #fde8e8; border: 1px solid #f5c0c0; color: #8b2020; padding: 0.85rem 1rem; border-radius: 8px; font-size: 0.87rem; margin-bottom: 1.5rem; }
    {% endif %}

    @media (max-width: 768px) {
        .login-left { display: none; }
        .login-right { width: 100%; }
    }

    @media (prefers-reduced-motion: reduce) {
        .login-left-content,
        .login-card {
            animation: none !important;
        }
    }
</style>
{% endblock %}

{% block body %}
<div class="login-wrapper">
    <div class="login-left">
        <div class="login-left-content">
            <div class="login-icon"></div>
            <div class="login-brand">Bins <span>Cafe</span></div>
            <p class="login-tagline">Your cozy corner, always</p>
            <p class="login-quote">Great days start with great coffee — and great coffee starts here.</p>
        </div>
    </div>
    <div class="login-right">
        <div class="login-card">
            <h1 class="login-card-title">Welcome back</h1>
            <p class="login-card-sub">Sign in to your Bins Cafe account</p>

            {% for message in app.flashes('error') %}
                <div class="alert-error">{{ message }}</div>
            {% endfor %}

            <form method="post" action="{{ path('app_login') }}">
                <div class="form-group">
                    <label for="username">Email Address</label>
                    <input type="email" id="username" name="_username" value="{{ last_username ?? '' }}" placeholder="you@example.com" required autofocus>
                </div>
                <div class="form-group">
                    <label for="password">Password</label>
                    <input type="password" id="password" name="_password" placeholder="Enter your password" required>
                </div>
                <div class="form-options">
                    <label class="form-check">
                        <input type="checkbox" name="_remember_me"> Remember me
                    </label>
                    <a href="#" class="form-forgot">Forgot password?</a>
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <button type="submit" class="btn-login">Sign In →</button>
            </form>
            <div class="login-back">
                <a href="{{ path('app_home') }}">← Back to Home</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
