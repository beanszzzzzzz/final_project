{% extends 'base.html.twig' %}
{% block title %}About Us — Bins Cafe{% endblock %}

{% block stylesheets %}
<style>
    @keyframes fadeUpSoft {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .page-hero {
        background: var(--brown-dark);
        padding: 6rem 2rem 5rem;
        text-align: center;
        position: relative;
        overflow: hidden;
    }
    .page-hero::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse 60% 80% at 50% 100%, rgba(200,134,74,0.2) 0%, transparent 70%);
    }
    .page-hero-content { position: relative; z-index: 1; animation: fadeUpSoft 0.6s ease-out both; }
    .page-hero-tag { display: inline-block; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.2em; color: var(--accent); border: 1px solid rgba(200,134,74,0.4); padding: 0.35rem 1rem; border-radius: 50px; margin-bottom: 1.5rem; }
    .page-hero h1 { font-family: 'Playfair Display', serif; font-size: clamp(2.2rem, 5vw, 3.5rem); color: var(--cream-light); line-height: 1.2; margin-bottom: 1rem; }
    .page-hero p { font-size: 1.05rem; color: var(--cream-dark); opacity: 0.8; max-width: 560px; margin: 0 auto; line-height: 1.75; }

    /* mission */
    .mission { background: var(--cream-light); }
    .mission-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: center; }
    .mission-inner > div { animation: fadeUpSoft 0.55s ease-out both; }
    .mission-inner > div:last-child { animation-delay: 0.08s; }
    .mission-box { background: var(--brown-dark); color: var(--cream-light); padding: 3rem; border-radius: 16px; }
    .mission-box h2 { font-family: 'Playfair Display', serif; font-size: 1.8rem; color: var(--cream-light); margin-bottom: 1.5rem; }
    .mission-box p { font-size: 0.95rem; color: var(--cream-dark); line-height: 1.75; margin-bottom: 1rem; opacity: 0.85; }
    .mission-values { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 2rem; }
    .mission-value { background: rgba(255,255,255,0.07); border-radius: 8px; padding: 1rem; border: 1px solid rgba(255,255,255,0.1); }
    .mission-value-icon { font-size: 1.4rem; margin-bottom: 0.4rem; }
    .mission-value h4 { font-size: 0.85rem; color: var(--accent); margin-bottom: 0.3rem; }
    .mission-value p { font-size: 0.8rem; color: var(--text-light); margin: 0; }

    /* timeline */
    .timeline-section { background: var(--cream-mid); }
    .timeline-section .section-title { text-align: center; margin-bottom: 3rem; }
    .timeline { display: flex; flex-direction: column; gap: 0; max-width: 700px; margin: 0 auto; }
    .timeline-item { display: grid; grid-template-columns: 120px 1fr; gap: 2rem; padding-bottom: 3rem; position: relative; }
    .timeline-item { animation: fadeUpSoft 0.5s ease-out both; }
    .timeline-item:nth-child(2) { animation-delay: 0.04s; }
    .timeline-item:nth-child(3) { animation-delay: 0.08s; }
    .timeline-item:nth-child(4) { animation-delay: 0.12s; }
    .timeline-item:not(:last-child)::before { content: ''; position: absolute; left: 58px; top: 44px; bottom: 0; width: 2px; background: var(--cream-dark); }
    .timeline-year { text-align: right; }
    .timeline-year-num { font-family: 'Playfair Display', serif; font-size: 1.3rem; color: var(--accent); font-weight: 700; }
    .timeline-dot { width: 14px; height: 14px; border-radius: 50%; background: var(--brown-dark); border: 3px solid var(--accent); position: absolute; left: 52px; top: 6px; }
    .timeline-content h3 { font-family: 'Playfair Display', serif; font-size: 1.1rem; color: var(--brown-dark); margin-bottom: 0.5rem; }
    .timeline-content p { font-size: 0.87rem; color: var(--text-mid); line-height: 1.65; }

    /* team */
    .team { background: var(--cream-light); }
    .team-header { text-align: center; margin-bottom: 3.5rem; }
    .team-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
    .team-card { background: var(--white); border-radius: 12px; overflow: hidden; border: 1px solid var(--cream-dark); text-align: center; transition: transform 0.2s, box-shadow 0.2s; }
    .team-card { animation: fadeUpSoft 0.55s ease-out both; }
    .team-card:nth-child(2) { animation-delay: 0.06s; }
    .team-card:nth-child(3) { animation-delay: 0.12s; }
    .team-card:hover { transform: translateY(-5px); box-shadow: 0 10px 30px rgba(59,31,31,0.1); }
    .team-avatar { height: 220px; background: #e7d2bd; overflow: hidden; }
    .team-avatar.alt1 { background: #dec4ab; }
    .team-avatar.alt2 { background: #d4b295; }
    .team-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center 30%;
        display: block;
        image-rendering: auto;
    }
    .team-photo-jim { object-position: center 24%; }
    .team-photo-ana { object-position: center 26%; }
    .team-photo-carlo { object-position: center 22%; }
    .team-body { padding: 1.5rem; }
    .team-name { font-family: 'Playfair Display', serif; font-size: 1.15rem; color: var(--brown-dark); margin-bottom: 0.3rem; }
    .team-role { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent); margin-bottom: 0.8rem; }
    .team-bio { font-size: 0.85rem; color: var(--text-mid); line-height: 1.6; }
    .symbol-sticker {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.7em;
        height: 1.7em;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.15);
        border: 1px solid rgba(255, 255, 255, 0.28);
        color: var(--cream-light);
        font-size: 0.9em;
        line-height: 1;
        font-weight: 700;
    }
    .team-avatar .symbol-sticker {
        width: 2.2em;
        height: 2.2em;
        font-size: 1.2em;
    }

    @media (max-width: 768px) {
        .mission-inner { grid-template-columns: 1fr; }
        .team-grid { grid-template-columns: 1fr; }
        .timeline-item { grid-template-columns: 80px 1fr; }
    }

    @media (prefers-reduced-motion: reduce) {
        .page-hero-content,
        .mission-inner > div,
        .timeline-item,
        .team-card {
            animation: none !important;
        }
    }
</style>
{% endblock %}

{% block body %}

<div class="page-hero">
    <div class="page-hero-content">
        <span class="page-hero-tag">Our Story</span>
        <h1>We Are Bins Cafe</h1>
        <p>A family-run coffee shop in the heart of Cebu, built on the belief that good coffee brings good people together.</p>
    </div>
</div>

<section class="mission">
    <div class="container mission-inner">
        <div>
            <p class="section-label">Who We Are</p>
            <h2 class="section-title">More Than Just a Cafe</h2>
            <p class="section-sub" style="margin-bottom: 1rem;">Bins Cafe was born in 2020 from a simple idea: create a space where anyone — students, professionals, families — can come together over exceptional coffee.</p>
            <p style="font-size: 0.95rem; color: var(--text-mid); line-height: 1.75; max-width: 480px;">We are committed to sustainability, supporting local farmers, and giving back to the community that made us who we are today.</p>
            <div style="margin-top: 2rem;">
                <a href="{{ path('app_contact') }}" class="btn-primary">Say Hello</a>
            </div>
        </div>
        <div class="mission-box">
            <h2>Our Mission</h2>
            <p>To craft exceptional coffee experiences that bring people together, support local communities, and make every cup feel like a warm embrace.</p>
            <div class="mission-values">
                <div class="mission-value">
                    <div class="mission-value-icon"><span class="symbol-sticker">◍</span></div>
                    <h4>Sustainability</h4>
                    <p>Eco-friendly practices, always.</p>
                </div>
                <div class="mission-value">
                    <div class="mission-value-icon"><span class="symbol-sticker">◇</span></div>
                    <h4>Community</h4>
                    <p>Local sourcing, local love.</p>
                </div>
                <div class="mission-value">
                    <div class="mission-value-icon"><span class="symbol-sticker">✦</span></div>
                    <h4>Quality</h4>
                    <p>No shortcuts, ever.</p>
                </div>
                <div class="mission-value">
                    <div class="mission-value-icon"><span class="symbol-sticker">♥</span></div>
                    <h4>Warmth</h4>
                    <p>Every guest is family.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="timeline-section">
    <div class="container">
        <p class="section-label" style="text-align:center;">Our Journey</p>
        <h2 class="section-title">How We Got Here</h2>
        <div class="timeline">
            <div class="timeline-item">
                <div class="timeline-year"><div class="timeline-year-num">2020</div></div>
                <div class="timeline-dot"></div>
                <div class="timeline-content">
                    <h3>The First Cup</h3>
                    <p>Bins Cafe opened its doors with just 4 tables, a secondhand espresso machine, and a whole lot of passion. The neighborhood noticed immediately.</p>
                </div>
            </div>
            <div class="timeline-item">
                <div class="timeline-year"><div class="timeline-year-num">2021</div></div>
                <div class="timeline-dot"></div>
                <div class="timeline-content">
                    <h3>Growing Our Roots</h3>
                    <p>We partnered with three local farms in Benguet and Bukidnon to source single-origin beans, and introduced our signature in-house pastry line.</p>
                </div>
            </div>
            <div class="timeline-item">
                <div class="timeline-year"><div class="timeline-year-num">2022</div></div>
                <div class="timeline-dot"></div>
                <div class="timeline-content">
                    <h3>Expanding the Space</h3>
                    <p>We moved to a larger location with a dedicated events corner, a full kitchen, and seating for 60 — still keeping that cozy feeling alive.</p>
                </div>
            </div>
            <div class="timeline-item">
                <div class="timeline-year"><div class="timeline-year-num">2024</div></div>
                <div class="timeline-dot"></div>
                <div class="timeline-content">
                    <h3>5,000 Happy Guests</h3>
                    <p>A milestone we're incredibly proud of. Our loyalty program launched, and we hosted our first annual Bins Coffee Fest.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="team">
    <div class="container">
        <div class="team-header">
            <p class="section-label">The People</p>
            <h2 class="section-title">Meet Our Team</h2>
            <p class="section-sub" style="margin: 0 auto;">Every great cup starts with a great person behind the machine.</p>
        </div>
        <div class="team-grid">
            <div class="team-card">
                <div class="team-avatar"><img class="team-photo-jim" src="/images/team/jim-dela-cruz.jpeg" alt="Jim dela Cruz portrait"></div>
                <div class="team-body">
                    <h3 class="team-name">Jim dela Cruz</h3>
                    <p class="team-role">Founder & Head Barista</p>
                    <p class="team-bio">Jim started Bins Cafe with nothing but a dream and a love for coffee. He personally trains every barista on the team.</p>
                </div>
            </div>
            <div class="team-card">
                <div class="team-avatar alt1"><img class="team-photo-ana" src="/images/team/ana-reyes.jpeg" alt="Ana Reyes portrait"></div>
                <div class="team-body">
                    <h3 class="team-name">Ana Reyes</h3>
                    <p class="team-role">Operations Manager</p>
                    <p class="team-bio">Ana keeps everything running smoothly — from supplier relationships to daily operations, she's the backbone of Bins Cafe.</p>
                </div>
            </div>
            <div class="team-card">
                <div class="team-avatar alt2"><img class="team-photo-carlo" src="/images/team/carlo-mendez.jpeg" alt="Carlo Mendez portrait"></div>
                <div class="team-body">
                    <h3 class="team-name">Carlo Mendez</h3>
                    <p class="team-role">Pastry Chef</p>
                    <p class="team-bio">Carlo bakes everything fresh every morning. He's the reason guests come in early — the smell of his croissants is irresistible.</p>
                </div>
            </div>
        </div>
    </div>
</section>

{% endblock %}
