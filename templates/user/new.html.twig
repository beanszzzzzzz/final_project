{% extends 'base.html.twig' %}

{% block title %}Create User{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .role-group {
        display: grid;
        gap: 8px;
        padding: 12px;
        border: 1px solid #e4d0bd;
        border-radius: 10px;
        background: #fff9f2;
    }

    .role-group label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin: 0;
    }

    .checkbox-row {
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }
</style>
{% endblock %}

{% block body %}
<div class="form-container">
    <div class="form-header">
        <h1>Create New User</h1>
    </div>

    {{ form_start(form) }}
        <div class="form-group">
            {{ form_label(form.email) }}
            {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'user@binscafe.com'}}) }}
            {{ form_errors(form.email) }}
            <span class="input-help">This email will be used for sign in.</span>
        </div>

        <div class="form-group">
            {{ form_label(form.plainPassword) }}
            {{ form_widget(form.plainPassword, {'attr': {'class': 'form-control', 'placeholder': 'At least 6 characters'}}) }}
            {{ form_errors(form.plainPassword) }}
            <span class="input-help">Leave blank only if you plan to set it later.</span>
        </div>

        <div class="form-group">
            {{ form_label(form.roles) }}
            <div class="role-group">
                {{ form_widget(form.roles) }}
            </div>
            {{ form_errors(form.roles) }}
        </div>

        <div class="form-group">
            <div class="checkbox-row">
                {{ form_widget(form.isActive) }}
                {{ form_label(form.isActive) }}
            </div>
            {{ form_errors(form.isActive) }}
            <span class="input-help">Inactive users cannot access the dashboard.</span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Create User</button>
            <a href="{{ path('app_user_index') }}" class="btn btn-secondary">Cancel</a>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}